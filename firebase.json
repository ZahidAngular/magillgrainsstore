{
  "hosting": {
    "public": "out",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
    "cleanUrls": true,
    "trailingSlash": false,
    "redirects": [
      { "source": "/rat-mouse", "destination": "/products", "type": 301 },
      { "source": "/rat-mouse/", "destination": "/products", "type": 301 },
      { "source": "/passwell-wambaroo-and-vitafarm", "destination": "/shop/passwell-wambaroo-and-vitafarm", "type": 301 },
      { "source": "/passwell-wambaroo-and-vitafarm/", "destination": "/shop/passwell-wambaroo-and-vitafarm", "type": 301 },
      { "source": "/bird-seed-1-10kg", "destination": "/shop/bird-seed", "type": 301 },
      { "source": "/bird-seed-1-10kg/", "destination": "/shop/bird-seed", "type": 301 },
      { "source": "/rabbit-supplies", "destination": "/shop/rabbit-supplies", "type": 301 },
      { "source": "/rabbit-supplies/", "destination": "/shop/rabbit-supplies", "type": 301 }
    ],
    "headers": [
      {
        "source": "**",
        "headers": [
          { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" },
          { "key": "X-Content-Type-Options", "value": "nosniff" },
          { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
        ]
      },
      {
        "source": "/_next/static/**",
        "headers": [
          { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
        ]
      }
    ]
  }
}
